# Local dev for hh-api: copy to .env (git-ignored). scripts/dev/stack.sh loads it.
# Dev-only settings are refused on PORT=8081 or a non-loopback HOST (internal/config).
PORT=8091
HOST=127.0.0.1
DB_PATH=./hh-dev.db
FIREBASE_PROJECT_ID=demo-household-helper
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
DEV_SEED=1
LOG_LEVEL=debug

# Real-Firebase check (before a release): real project id, emulator host empty, no seed.
# FIREBASE_PROJECT_ID=<your-project>
# FIREBASE_AUTH_EMULATOR_HOST=
# DEV_SEED=
# FCM_SERVICE_ACCOUNT_FILE=   # leave empty locally; push stays disabled
