{
  "permissions": {
    "allow": [
      "Bash(scripts/dev/:*)",
      "Bash(./scripts/dev/:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcodebuild:*)",
      "Bash(axe:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(./gradlew:*)",
      "Bash(make -C apps/api:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(npx firebase:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(jq:*)",
      "Bash(lsof -i:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(df -h:*)",
      "Read(.dev/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/secrets-check.sh --hook"
          }
        ]
      }
    ]
  }
}
